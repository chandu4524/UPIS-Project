# GPIP Backend — copy to .env and adjust for your environment
APP_ENV=development
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=120
OCR_REQUEST_TIMEOUT_SECONDS=300

# OCR — on Render use Docker image (see DEPLOY_RENDER_OCR.md)
# TESSERACT_CMD=/usr/bin/tesseract
# POPPLER_PATH=/usr/bin
# OCR_FOLDER=/tmp/ocr_uploads
# OCR_PDF_DPI=150
# OCR_MAX_PAGES=15
# OCR_MAX_FILE_BYTES=15728640
# OCR_USE_PADDLE=false

# Database (SQLite default for local dev)
# DATABASE_URL=sqlite:///./data/upis.db
# DATABASE_URL=postgresql://user:password@localhost:5432/gpip

# Security — required in production
SECRET_KEY=change-me-to-a-long-random-string

# JWT token lifetime (minutes)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# File storage (optional; defaults to backend/uploads and backend/ocr_uploads)
# UPLOAD_FOLDER=uploads
# OCR_FOLDER=ocr_uploads

# Default officer seed (first run only)
# DEFAULT_OFFICER_USERNAME=officer
# DEFAULT_OFFICER_PASSWORD=officer123
# DEFAULT_OFFICER_ROLE=admin
